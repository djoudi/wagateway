# ─────────────────────────────────────────────────────────────────────────
# WaGateway — Environment Variables
# Copy to .env for local dev, or set these in the platform (EasyPanel)
# environment for containerised deployments.
# ─────────────────────────────────────────────────────────────────────────

APP_NAME="WaGateway"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Algiers
APP_URL=https://your-domain.example
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wagateway
DB_USERNAME=wagateway
DB_PASSWORD=

# ── Redis (cache, queues, Horizon, Reverb) ────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=wg_

# ── Queue ─────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=redis-queue

# ── Cache / Session / Broadcast ───────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=wg_cache_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=reverb

# ── Reverb (WebSocket) ────────────────────────────────────────────────────
REVERB_SERVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_APP_ID=wagateway
REVERB_APP_KEY=wagateway-local-key
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=*
# Browser-facing Vite build variables (public WebSocket through nginx):
VITE_REVERB_APP_KEY=wagateway-local-key
VITE_REVERB_HOST=your-domain.example
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# ── WhatsApp service (Node.js wa-service) ─────────────────────────────────
WA_SERVICE_URL=http://127.0.0.1:3000
WA_SERVICE_SECRET=change-me-min-32-chars

# ── Admin / business configuration ────────────────────────────────────────
ADMIN_EMAILS=admin@example.com
SUBSCRIPTION_GRACE_DAYS=3
DEVICE_IDLE_MINUTES=15
BULK_DELAY_MIN=2
BULK_DELAY_MAX=10
HORIZON_PREFIX=wg_horizon_

# ── Chargily Pay (billing) ────────────────────────────────────────────────
CHARGILY_MODE=test
CHARGILY_API_KEY=
CHARGILY_WEBHOOK_SECRET=

# ── Mail ──────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Logging ───────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=info
